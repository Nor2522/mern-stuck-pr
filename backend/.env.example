# Backend environment variables (names only — never commit real values).
# Copy to backend/.env and fill in.

# Port the API listens on (default 5000). Keep 5000 for the Vite dev proxy.
PORT=
# MongoDB connection string (required). The legacy name DB_URI is also accepted.
MONGODB_URI=
# Long random string used to sign JWTs (required).
JWT_SECRET=
# Token/cookie lifetime, e.g. 30d (default). The legacy name EXPIRE_IN is also accepted.
JWT_EXPIRES_IN=
# Allowed browser origin(s). Comma-separated, e.g.
# http://localhost:5173,http://localhost:5174
# In production ONLY these exact origins are allowed. In development any
# http://localhost:<port> / http://127.0.0.1:<port> is also allowed.
CLIENT_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Used only by `bun run seed:admin` to create the first admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=