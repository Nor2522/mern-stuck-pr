# Client environment variables (names only — never commit real values).
# Copy to client/.env and fill in.

# Base URL of the API. Optional in development: the Vite dev server proxies
# /api -> http://localhost:5000 and the app falls back to
# http://localhost:5000/api when unset. Set it for production, e.g.
# https://api.example.com/api
VITE_API_URL=
